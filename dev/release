#!/bin/sh
# A release is cut by GitHub Actions, not here: an annotated tag on master,
# pushed, and .github/workflows/release.yml builds it with dev/pack and
# publishes pspdx.zip under the version, with the tag's message for notes.
#
#   git tag -a v1.2.0 -m "What changed" && git push origin v1.2.0
#
# Here only the dry run, which packs the same zip from the tree as it stands
# and publishes nothing:
#
#   PACK_ONLY=1 dev/release 1.2.0
set -e
[ "${PACK_ONLY:-0}" = 1 ] || {
	echo "releases are made by pushing a tag: git tag -a v<version> -m \"notes\" && git push origin v<version>" >&2
	echo "PACK_ONLY=1 dev/release <version> packs pspdx.zip here without publishing" >&2
	exit 1
}
exec "$(cd "$(dirname "$0")" && pwd)/pack" "$@"
