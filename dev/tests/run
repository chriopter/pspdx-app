#!/bin/sh
set -eu
HERE=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
APP=$(CDPATH= cd -- "$HERE/../../app" && pwd)
TEST_WORK=$(mktemp -d)
trap 'rm -rf "$TEST_WORK"' EXIT HUP INT TERM
cc -g -O1 -fsanitize=address,undefined -Wno-deprecated-declarations \
  -I"$HERE/host" -I"$APP" -I"$APP/lib/pspkit-https/include" \
  "$HERE/host/io.c" "$HERE/host/main.c" \
  "$APP/util/storage.c" "$APP/util/pbp.c" "$APP/install/state.c" "$APP/install/install.c" \
  "$APP/install/zipread.c" "$APP/update/sources.c" "$APP/update/presets.c" "$APP/update/reach.c" "$APP/update/pspdx.c" \
  "$APP/update/catalog.c" "$APP/update/gunzip.c" "$APP/update/inbox.c" "$APP/session/view.c" "$APP/session/manage_sources.c" "$APP/gui/wrap.c" \
  -lcjson -lz -lcrypto -o "$TEST_WORK/client"
cc -g -O1 -fsanitize=address,undefined -I"$HERE/host" -I"$APP" \
  "$HERE/host/image.c" "$APP/gui/image.c" $(pkg-config --cflags --libs libpng) -o "$TEST_WORK/image"
cc -g -O1 -fsanitize=address,undefined -I"$APP" \
  "$HERE/host/video.c" "$APP/video/mp4.c" "$APP/video/psmf.c" -o "$TEST_WORK/video"
cc -g -O1 -fsanitize=address,undefined -pthread \
  -I"$HERE/downloads" -I"$HERE/host" -I"$APP" -I"$APP/lib/pspkit-https/include" \
  "$HERE/downloads/test.c" "$APP/session/downloads.c" "$APP/session/view.c" -o "$TEST_WORK/downloads"
cc -g -O1 -ffunction-sections -fdata-sections -fsanitize=address,undefined \
  -I"$HERE/downloads" -I"$HERE/host" -I"$APP" -I"$APP/lib/pspkit-https/include" \
  "$HERE/downloads/settings.c" "$APP/session/options.c" -Wl,--gc-sections -o "$TEST_WORK/settings"
"$TEST_WORK/downloads"
"$TEST_WORK/settings"
ASAN_OPTIONS=detect_leaks=0 "$TEST_WORK/video" "$APP/assets/icon1.pmf"
PSPDX_TEST_BIN="$TEST_WORK/client" PSPDX_IMAGE_BIN="$TEST_WORK/image" python3 "$HERE/test_client.py" -v
