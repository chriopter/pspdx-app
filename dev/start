#!/bin/sh
# Builds the client and opens it in PPSSPP, as one instance that outlives
# this shell. Stale instances are stopped first: two at once write the same
# files and play the same tune, slightly apart.
#
#   dev/start            build if needed, start
#   dev/start --reset    also forget the seed: the sweep runs, as on a new PSP
#   dev/start --no-build
#   dev/start --quiet    no speakers: the emulator gets no audio socket
#   dev/start --owner X  whose instance this is (default: the shell's user).
#                        Only an instance with the same owner is replaced;
#                        one somebody else opened is left alone.
#   dev/start --slow     the network held to a PSP-1004's 180 KB/s (802.11b)
#   dev/start --mock     a made-up catalog of thirty served from the host
#
# --mock builds the client against tools/localcat's throwaway CA and a
# loopback catalog URL, has dev/mock-catalog generate thirty entries out of
# the three published apps' assets, plants db records so a third of the rows
# are installed and a third have an update waiting, and serves the lot over
# TLS as the user unit pspdx-mock-server, which outlives this shell. A later
# dev/start without it stops that server, rebuilds for the published catalog
# and takes the mock's records and PSP/GAME directories off the stick again
# -- the ones it wrote down and anything wearing the same prefix, which is
# what an install done from the mock catalog leaves; never anything
# installed for real.
#
# The stick gets what a run needs and PPSSPP does not provide: the system
# font (PPSSPP has it but does not mount flash0 for the guest), the clips
# from the catalog repo next door if there is one, and a seed, so the client
# starts the way a PSP does after its first run. Nothing here is real
# entropy; a PSP that has run this build is not one to sign with.
set -e
HERE="$(cd "$(dirname "$0")/.." && pwd)"
APP="$HERE/app"
MS="$HOME/.var/app/org.ppsspp.PPSSPP/config/ppsspp"
RESET=0
BUILD=1
AUDIO=""
SLOW=0
OWNER="${PSPDX_OWNER:-$USER}"
MOCK=0
while [ $# -gt 0 ]; do
	arg="$1"
	case "$arg" in
		--reset) RESET=1 ;;
		--no-build) BUILD=0 ;;
		--quiet) AUDIO="--nosocket=pulseaudio" ;;
		--owner) OWNER="$2"; shift ;;
		--slow) SLOW=1 ;;
		--mock) MOCK=1 ;;
		*) echo "unknown option $arg" >&2; exit 2 ;;
	esac
	shift
done

. "$APP/tools/localcat/common.sh"

if [ "$MOCK" = 1 ]; then
	python3 "$HERE/dev/mock-catalog" make --work "$WORK" --ms "$MS" --url "$LOCALCAT_URL"
	# The URL and the CA are compiled in, so a client already built for the
	# host only needs building again when something else changed.
	if [ "$BUILD" = 1 ] || ! localcat_is_local; then
		localcat_build_local || { echo "mock build failed" >&2; exit 1; }
	fi
else
	# Whatever the mock left behind goes first: the server on the port, the
	# records and directories it planted, and an EBOOT that still points at
	# the host. That last one has to be rebuilt even under --no-build, or
	# the run would quietly be a mock run.
	localcat_stop_server
	python3 "$HERE/dev/mock-catalog" clean --work "$WORK" --ms "$MS"
	if localcat_is_local; then
		echo "rebuilding for the published catalog"
		localcat_build_real || { echo "build failed" >&2; exit 1; }
	elif [ "$BUILD" = 1 ]; then
		# The Docker build sees no .git, so the version is handed in: the tag
	# without its v, as the catalog spells it, or the commit when untagged.
	V="$(cd "$HERE" && git describe --tags --always 2>/dev/null | sed 's/^v//')"
	(cd "$APP" && docker run --rm -v "$PWD:/src" -w /src pspdev/pspdev:latest make PSPDX_VERSION="${V:-dev}" 2>&1 \
			| grep -E 'error|EBOOT\.PBP' || true)
	fi
fi
[ -f "$APP/EBOOT.PBP" ] || { echo "no EBOOT.PBP" >&2; exit 1; }

mkdir -p "$MS/PSP/GAME/pspdx" "$MS/PSP/PSPDX/font" "$MS/PSP/PSPDX/cache"
cp "$APP/EBOOT.PBP" "$MS/PSP/GAME/pspdx/"

FONTS="$(flatpak info --show-location org.ppsspp.PPSSPP 2>/dev/null)/files/share/ppsspp/assets/flash0/font"
[ -f "$FONTS/ltn8.pgf" ] && cp "$FONTS/ltn8.pgf" "$MS/PSP/PSPDX/font/ltn8.pgf"

# The films out of a catalog site built next door, planted under the name an
# entry that links no film is looked up by, so a row has something to play
# before anything is fetched. The catalog keeps one directory an app, and the
# directory is the id.
for clip in "$HERE"/../pspdx-catalog/site/apps/*/film-*.pmf \
            "$HERE"/catalog/site/apps/*/film-*.pmf; do
	[ -f "$clip" ] || continue
	cp "$clip" "$MS/PSP/PSPDX/cache/$(basename "$(dirname "$clip")").mp4"
done

rm -f "$MS/PSPDX.REPLAY" "$MS/PSPDX.KEYS" "$MS/PSPDX.INSTALL" "$MS/PSPDX.SLOW"
# Tux Racer is always behind: its record is set to revision 1 when it is
# installed, so the catalog's release counts as newer and the list has one
# row with the update arrows on it to look at.
TUX="$MS/PSP/PSPDX/db/io.github.chriopter.extremetuxracer.json"
[ -f "$TUX" ] && python3 - "$TUX" <<'PY'
import json, sys
p = sys.argv[1]
r = json.load(open(p))
r["rev"] = 1
r["version"] = "0.0.1"
open(p, "w").write(json.dumps(r, separators=(",", ":")) + "\n")
PY
# The host's network is ten times a PSP's; with the file there the client
# holds every fetch to what the 1004's radio and stack actually deliver.
[ "$SLOW" = 1 ] && printf '180' >"$MS/PSPDX.SLOW"
if [ "$RESET" = 1 ]; then
	rm -f "$MS/PSPDX.SEED"
else
	[ -f "$MS/PSPDX.SEED" ] || printf 'PSPDX-TEST-SEED-0000' >"$MS/PSPDX.SEED"
fi

if [ "$MOCK" = 1 ]; then
	localcat_start_server "$WORK/mock-site"
	echo "mock catalog on $LOCALCAT_URL (systemctl --user stop pspdx-mock-server)"
fi

# Only this owner's instance makes way. The emulator carries its owner in
# its environment, so an instance somebody else opened by hand -- the user
# looking at the desk while an agent tests -- is not theirs to end and is
# left running; the unit name carries the owner too, so two can coexist.
UNIT="pspdx-ppsspp"
[ "$OWNER" != "$USER" ] && UNIT="pspdx-ppsspp-$OWNER"
systemctl --user stop "$UNIT" 2>/dev/null || true
for pid in $(pgrep -x PPSSPPSDL 2>/dev/null); do
	if tr '\0' '\n' <"/proc/$pid/environ" 2>/dev/null | grep -qx "PSPDX_OWNER=$OWNER"; then
		kill "$pid" 2>/dev/null || true
	fi
done
sleep 1
# Native: the emulator renders the PSP's own 480x272 and only the window
# scales it, so what is on screen is what a PSP shows, pixel for pixel.
# The ini is rewritten by a running emulator on exit, which is why this
# comes after the old instance is gone.
# The settings and the keyboard map under dev/ppsspp, so that every desk and
# every rig plays the same way.
INI="$MS/PSP/SYSTEM/ppsspp.ini"
if [ -f "$INI" ]; then
	grep -v '^#' "$HERE/dev/ppsspp/settings" | while IFS='=' read -r key value; do
		key=$(printf '%s' "$key" | sed 's/ *$//'); value=$(printf '%s' "$value" | sed 's/^ *//')
		[ -n "$key" ] && sed -i "s/^$key = .*/$key = $value/" "$INI"
	done
fi
mkdir -p "$MS/PSP/SYSTEM"
cp "$HERE/dev/ppsspp/controls.ini" "$MS/PSP/SYSTEM/controls.ini"
systemd-run --user --collect --quiet --unit="$UNIT" \
  --setenv=SDL_VIDEODRIVER=wayland --setenv=WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-1}" \
  flatpak run --socket=wayland --share=network $AUDIO --env=PSPDX_OWNER="$OWNER" --filesystem="$MS" \
  org.ppsspp.PPSSPP --fullscreen=0 "$MS/PSP/GAME/pspdx/EBOOT.PBP"
sleep 3
# Where it opens is Hyprland's business: a window rule in
# ~/.config/hypr/hyprland.lua sends the emulator to workspace 2 without
# focus, so the desk it was started from keeps what was being worked on.
echo "PPSSPP is up (workspace 2 by window rule). Stop it with: systemctl --user stop $UNIT"
