LICENSES = ["GPL-2.0", "MIT", "BSD-3-Clause", "Apache-2.0", "Zlib"]

# Publication times count from a fixed point, so the dates look like the
# published catalog's without depending on the clock. The catalog carries
# them as ISO 8601; the client keeps the seconds, and so does a record.
REV_BASE = 1789000000


def iso(seconds):
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(seconds))


def slug(name):
    out = "".join(c for c in name if c.isalnum())
    return out[:16] or "App"


def fetch(url, dest):
    if os.path.exists(dest):
        return dest
    os.makedirs(os.path.dirname(dest), exist_ok=True)
    urllib.request.urlretrieve(url, dest + ".part")
    os.replace(dest + ".part", dest)
    return dest


def assets(work):
    """The three published apps' icons, shots and films, and one real EBOOT,
    fetched once into the work directory and reused from there."""
    cache = os.path.join(work, "mock-assets")
    cat = json.load(urllib.request.urlopen(SRC + "catalog.json"))
    apps = cat["apps"]
    have = {"icon": [], "screenshot": [], "video": []}
    for a in apps:
        for kind in have:
            rel = a.get("media", {}).get(kind)
            if rel:
                have[kind].append(fetch(SRC + rel, os.path.join(cache, rel)))

    # A real EBOOT.PBP, out of the smallest published release: it goes into
    # every planted PSP/GAME directory so START has something to launch, and
    # into every package so an install is a real install.
    eboot = os.path.join(cache, "EBOOT.PBP")
    if not os.path.exists(eboot):
        small = min((a for a in apps if a.get("releases")),
                    key=lambda a: a["releases"][0]["size"])
        raw = urllib.request.urlopen(small["releases"][0]["url"]).read()
        z = zipfile.ZipFile(io.BytesIO(raw))
        name = sorted(n for n in z.namelist() if n.lower().endswith("eboot.pbp"))[0]
        os.makedirs(cache, exist_ok=True)
        with open(eboot, "wb") as out:
            out.write(z.read(name))
    return have, eboot


def package(site, entry_id, dirname, payload):
    """One package per entry, with the EBOOT one directory down under the
    name that directory will have on the stick, so thirty installs do not
    land on top of each other."""
    buf = io.BytesIO()
    with zipfile.ZipFile(buf, "w", zipfile.ZIP_DEFLATED) as w:
        w.writestr("README.md", "%s, from the mock catalog.\n" % dirname)
        w.writestr("%s/EBOOT.PBP" % dirname, payload)
    blob = buf.getvalue()
    rel = "pkgs/%s.zip" % entry_id
    out = os.path.join(site, rel)
    os.makedirs(os.path.dirname(out), exist_ok=True)
    with open(out, "wb") as f:
        f.write(blob)
    return rel, hashlib.sha256(blob).hexdigest(), len(blob)


def make(work, ms, base):
    rng = random.Random(SEED)
    # A run starts from the state this file describes and no other: an
    # install or an update done in the client during the last one left a
    # record of its own behind, and those thirds are the point.
    clean(work, ms, quiet=True)
    site = os.path.join(work, "mock-site")
    shutil.rmtree(site, ignore_errors=True)
    os.makedirs(site)
    have, eboot = assets(work)
    with open(eboot, "rb") as f:
        payload = f.read()

    # A third of the rows in each state, mixed rather than every third row.
    third = COUNT // 3
    states = (["current"] * third + ["update"] * third +
              ["none"] * (COUNT - 2 * third))
    rng.shuffle(states)

    db_dir = os.path.join(ms, "PSP/PSPDX/INSTALLED")
    game_dir = os.path.join(ms, "PSP/GAME")
    os.makedirs(db_dir, exist_ok=True)
    os.makedirs(game_dir, exist_ok=True)
    planted = []
    apps = []
    installed = {}

    for i, (name, tag, author, kinds) in enumerate(ROWS[:COUNT]):
        tags = TAGS.get(name, [tag])
        plugin = name in PLUGINS
        entry_id = "%sapp%02d%s" % (ID_PREFIX, i, slug(name).lower()[:32])
        dirname = "%s%02d%s" % (DIR_PREFIX, i, slug(name)[:21])
        rev = REV_BASE + i * 1000
        version = "%d.%d.%d" % (1 + i // 10, i % 10, i % 3)
        if name in LONG_TAGS:
            version = LONG_TAGS[name][1:]
        rel, sha, size = package(site, entry_id, dirname, payload)

        # The shape schema/catalog-v1.json gives an entry, which is what
        # update/catalog.c reads: the releases newest first, each a tag, when
        # it was published and a download. dev/tests/test_client.py feeds one
        # of these through that parser, so the two cannot drift apart
        # unnoticed.
        app = {
            "id": slug(name).lower() if name == SLUGGED else entry_id,
            "source": "https://github.com/pspdxmock/" + entry_id[len(ID_PREFIX):],
            "name": name,
            **({"type": "plugin"} if plugin else {"installdir": "PSP/GAME/" + dirname}),
            **({"tags": tags} if tags else {}),
            **({"category": CATEGORY[name][0]} if name in CATEGORY else {}),
            "author": AUTHORS[author],
            "summary": SUMMARIES[rng.randrange(len(SUMMARIES))],
            "license": LICENSES[i % len(LICENSES)],
            **({"description": DESCRIPTIONS[name]} if name in DESCRIPTIONS else {}),
            **({"listed_by": LISTED[name]} if name in LISTED else {}),
            "releases": [{
                "tag": "v" + version,
                "published_at": iso(rev),
                "url": base + rel, "size": size, "sha256": sha,
            }],
        }
        # The assets, laid out the way the published catalog lays them out:
        # one directory an app, the kind and a hash of the bytes in the name,
        # the file as it was served. The client keys its cache on the served
        # name, so a mock that names its files differently would exercise a
        # path the real one never takes.
        media = {}
        for kind, letter, called in (("icon", "i", "icon"),
                                     ("screenshot", "s", "picture"),
                                     ("video", "v", "film")):
            if letter not in kinds or not have[kind]:
                continue
            src = have[kind][i % len(have[kind])]
            with open(src, "rb") as f:
                eight = hashlib.sha256(f.read()).hexdigest()[:8]
            ext = os.path.splitext(src)[1] or ".bin"
            rel_asset = "apps/%s/%s-%s%s" % (entry_id, called, eight, ext)
            dest = os.path.join(site, rel_asset)
            os.makedirs(os.path.dirname(dest), exist_ok=True)
            shutil.copyfile(src, dest)
            if kind == "screenshot":
                media["screenshots"] = [rel_asset]
            else:
                media[kind] = rel_asset
        if media:
            app["media"] = media
        manifest=dict(schema="https://chriopter.github.io/pspdx/schema/pspdx-v1.json",source=app["source"],name=name[:39],
                      **{k: app[k] for k in ("type", "category", "tags", "installdir", "description", "listed_by")
                         if k in app})
        app["_test_manifest"]=manifest
        apps.append(app)

        state = states[i]
        if state == "none":
            continue
        if state == "current":
            record = {"id": entry_id, "rev": rev, "dir": dirname,
                      "manifest": "", "version": version}
        else:
            # Behind the catalog by a revision and a version, which is the
            # one thing that puts the update arrows on a row.
            record = {"id": entry_id, "rev": rev - 500, "dir": dirname,
                      "manifest": "",
                      "version": "%d.%d.%d" % (i // 10, i % 10, i % 3)}
            if name in LONG_TAGS:
                record["version"] = version[:-len("final")] + "draft"
        rec_path = os.path.join(db_dir, entry_id + ".pspdx")
        with open(rec_path,"w") as output:json.dump(manifest,output)
        installed[entry_id]=dict(source=app["source"],added_from=base,installed=dict(version=record["version"],published_at=record["rev"],installdir="PSP/GAME/"+dirname))
        planted.append("db " + rec_path)

        # An installed app is a directory with an EBOOT in it, or START has
        # nothing to launch.
        target = os.path.join(game_dir, dirname)
        os.makedirs(target, exist_ok=True)
        shutil.copyfile(eboot, os.path.join(target, "EBOOT.PBP"))
        planted.append("dir " + target)

    catalog = {
        "schema": "https://chriopter.github.io/pspdx/schema/catalog-v1.json",
        "generated_at": "2026-01-01T00:00:00Z",
        "apps": apps,
    }
    with open(os.path.join(site, "catalog.json"), "w") as f:
        json.dump(catalog, f)
    for app_id, record in installed.items():
        path = os.path.join(db_dir, app_id + ".state.json")
        with open(path, "w") as output:
            json.dump(record, output)
        planted.append("db " + path)
    with open(os.path.join(work, "mock-planted"), "w") as f:
        f.write("\n".join(planted) + "\n")
    keep_sources(ms, base)

    waiting = states.count("update")
    print("mock catalog: %d apps, %d installed, %d updates waiting"
          % (len(apps), states.count("current") + waiting, waiting))


def keep_sources(ms, base):
    """The user's sources.txt and presets.seen kept, once: a backup or an
    absent mark already there means what the stick holds now is the mock's,
    and it is never copied over the user's. Then sources.txt names the mock
    catalog and nothing else. A mock build offers no presets, so
    presets.seen is kept only to be put back exactly as it was."""
    for rel in KEPT:
        path = os.path.join(ms, rel)
        if os.path.exists(path + BACKUP) or os.path.exists(path + ABSENT):
            continue
        os.makedirs(os.path.dirname(path), exist_ok=True)
        if os.path.exists(path):
            shutil.copyfile(path, path + BACKUP + ".part")
            os.replace(path + BACKUP + ".part", path + BACKUP)
        else:
            open(path + ABSENT, "w").close()
    with open(os.path.join(ms, KEPT[0]), "w") as f:
        f.write("# Written by dev/mock-catalog for a mock run; the next dev/start\n"
                "# without --mock puts yours back from sources.txt%s.\n%s\n" % (BACKUP, base))


def restore_sources(ms):
    """What keep_sources kept, back in place: the backup renamed over the
    mock's file, or the mock's file removed where the user had none. The
    number of files put back; 0 when there was nothing kept."""
    back = 0
    for rel in KEPT:
        path = os.path.join(ms, rel)
        if os.path.exists(path + BACKUP):
            os.replace(path + BACKUP, path)
            back += 1
        elif os.path.exists(path + ABSENT):
            if os.path.exists(path):
                os.remove(path)
            os.remove(path + ABSENT)
            back += 1
    return back


def clean(work, ms, quiet=False):
    """What make wrote down, and what an install done from the mock catalog
    in the client added next to it: a record whose id carries the mock
    prefix, a PSP/GAME directory named with it, a cached asset under one of
    those ids; and the user's sources.txt and presets.seen, back in place. Every path is checked for the prefix and for the directory it
    is supposed to sit in before anything is removed -- the user's real
    installs are in the same two directories and carry neither."""
    db_dir = os.path.realpath(os.path.join(ms, "PSP/PSPDX/INSTALLED"))
    game_dir = os.path.realpath(os.path.join(ms, "PSP/GAME"))
    cache_dir = os.path.realpath(os.path.join(ms, "PSP/PSPDX/CACHE/media"))

    # The manifest names what make planted; the sweep of the three
    # directories catches what the client planted afterwards.
    listing = os.path.join(work, "mock-planted")
    found = []
    if os.path.exists(listing):
        with open(listing) as f:
            for line in f:
                kind, _, path = line.strip().partition(" ")
                if kind in ("db", "dir") and path:
                    found.append(path)
        os.remove(listing)
    for directory in (db_dir, game_dir, cache_dir):
        for name in sorted(os.listdir(directory)) if os.path.isdir(directory) else []:
            found.append(os.path.join(directory, name))

    gone = 0
    for path in found:
        real = os.path.realpath(path)
        parent, base = os.path.split(real)
        if parent == game_dir:
            if not base.startswith(DIR_PREFIX):
                continue
        elif parent in (db_dir, cache_dir):
            if not base.startswith(ID_PREFIX):
                continue
        else:
            continue
        if os.path.isdir(real):
            shutil.rmtree(real)
        elif os.path.exists(real):
            os.remove(real)
        else:
            continue
        gone += 1
    if gone and not quiet:
        print("mock catalog: %d planted records, directories and assets removed"
              % gone)
    if restore_sources(ms) and not quiet:
        print("mock catalog: sources.txt and presets.seen put back")


def main():
    if len(sys.argv) < 2 or sys.argv[1] not in ("make", "clean"):
        sys.exit(__doc__)
    opts = dict(zip(sys.argv[2::2], sys.argv[3::2]))
    work, ms = opts.get("--work"), opts.get("--ms")
    if not work or not ms:
        sys.exit("mock-catalog: --work and --ms are required")
    os.makedirs(work, exist_ok=True)
    if sys.argv[1] == "clean":
        clean(work, ms)
    else:
        # Packages are named by an absolute URL; the assets beside them are
        # relative to the catalog, as in the published one. The caller owns
        # the address, so it says what it is.
        url = opts.get("--url", DEFAULT_URL)
        make(work, ms, url.rsplit("/", 1)[0] + "/")


if __name__ == "__main__":
    main()
