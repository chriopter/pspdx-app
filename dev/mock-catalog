# One release tag the longest the format allows, 64 characters, which the
# details band, the options' update row and the status line each cut to
# their own room.
LONG_TAGS = {"Master System": "v2.0.0-beta.3+build.20260911.gitabcdef0123456789-rc2-final-final"}

# A GitHub app that a list vouches for, so the band has a listed_by to say.
LISTED = {"ScummVM": "https://wijsman.de/psp-homebrew-database/"}

# Plugins by their type, which is what the plugins tab goes by. They name no
# folder under PSP/GAME; the catalog lists them and the console will not
# install them.
PLUGINS = ("CPU Clock", "Battery Meter")

AUTHORS = ["chriopter", "Homebrew Collective", "anon"]

# The stick's list of catalogs, and the presets it has already been offered.
# After a normal run the list names the published catalogs; a client built
# for the host trusts the throwaway CA alone, so those are handshake failures,
# and a run whose catalogs all fail asks GitHub app by app and shows the
# stick's installs instead of the mock's thirty. make keeps the user's files
# next to themselves -- on the stick, so a work directory wiped between two
# runs cannot take them along -- and clean puts them back.
KEPT = ("PSP/PSPDX/sources.txt", "PSP/PSPDX/presets.seen")
BACKUP = ".mock-backup"
ABSENT = ".mock-absent"

# Summaries of every length: nothing at all, a few words, a line that fills
# the row, and one of sixty characters, the most the format allows. None is
# longer: schema/catalog-v1.json caps a summary there, the catalog builder
# cuts one there, and dev/check-schemas holds this list to the schema.
SUMMARIES = [
    "",
    "Small.",
    "Downhill racing with a penguin.",
    "Thirteen Graphics Engine tricks, one scene each.",
    "Real-time ray tracing on a 333 MHz MIPS CPU.",
    "A tidy thing that does one job and gets out of the way.",
    "Reads the stick.",
