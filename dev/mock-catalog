#!/usr/bin/env python3
"""A mixed catalog for the desk: thirty entries made out of the three
published apps' assets, so the interactive emulator shows a list that has a
bit of everything -- all five categories, names short enough to fit and one
long enough to be clipped, entries missing an icon, a screenshot, a film or
all three, summaries of every length, three authors, and a third of the rows
in each install state.

Called by dev/start --mock; not meant to be run by hand.

    mock-catalog make  --work DIR --ms DIR [--url URL]
    mock-catalog clean --work DIR --ms DIR

make writes the site under <work>/mock-site, plants db records and PSP/GAME
directories on the emulator's stick, and lists everything it planted in
<work>/mock-planted. clean removes that, and anything else on the stick
wearing the mock's id or directory prefix, and nothing besides: the user's
own installs live in the same directories and carry neither prefix.

The generation is seeded and the assets are cached, so the same list comes
back every time and only the first run goes to the network.
"""
import hashlib, io, json, os, random, shutil, sys, urllib.request, zipfile

SRC = "https://chriopter." + "github.io/pspdx-catalog/"
SEED = 20260911
COUNT = 30
DEFAULT_URL = "https://127.0.0.1:8443/catalog.json"

# What a planted record, directory and cached asset are called. Only names
# carrying one of these are ever removed -- a published id is
# io.github.something and a real install is named after its own archive, so
# nothing of the user's can wear one by accident.
ID_PREFIX = "io.github.pspdxmock."
DIR_PREFIX = "PSPDXMock"

# Thirty rows: the name, the category, which of the three authors, and which
# of icon/screenshot/video it has. Written out rather than generated, because
# the point of the list is the variety and that is easier to read than to
# derive. assets: i icon, s screenshot, v film.
#                         name                                    category    author assets
ROWS = [
    ("Tux",                                                       "game",     0, "isv"),
    ("Pixel Pilot",                                               "game",     0, "isv"),
    ("Chronicles of the Dawnbringer Saga II",                     "game",     1, "isv"),
    ("Hex",                                                       "game",     2, "is"),
    ("Downhill",                                                  "game",     0, "isv"),
    ("Orbital Freight Company",                                   "game",     1, "sv"),
    ("Mine Cart Mayhem",                                          "game",     2, "isv"),
    ("Nine Lives",                                                "game",     0, ""),
    ("Lantern",                                                   "demo",     1, "isv"),
    ("Thirteen Tricks",                                           "demo",     0, "isv"),
    ("Plasma",                                                    "demo",     2, "iv"),
    ("Rust Raytracer",                                            "demo",     0, "isv"),
    ("A Study in Bilinear Filtering and Fog",                     "demo",     1, "is"),
    ("Vector Field",                                              "demo",     2, "isv"),
    ("Notes",                                                     "app",      0, "i"),
    ("Memory Stick Inspector",                                    "app",      1, "isv"),
    ("Clock",                                                     "app",      2, "isv"),
    ("IRC",                                                       "app",      0, "sv"),
    ("Weather Station Readout and Barometer",                     "app",      1, "isv"),
    ("File Browser",                                              "app",      2, "is"),
    ("Calculator",                                                "app",      0, "isv"),
    ("gpSP",                                                      "emulator", 1, "isv"),
    ("Chip-8",                                                    "emulator", 2, "iv"),
    ("Master System",                                             "emulator", 0, "isv"),
    ("NEC PC Engine and SuperGrafx",                              "emulator", 1, "isv"),
    ("ScummVM",                                                   "emulator", 2, "is"),
    ("CPU Clock",                                                 "plugin",   0, "i"),
    ("Screenshot Key",                                            "plugin",   1, "isv"),
    ("Remote Joystick Bridge for the USB Port",                   "plugin",   2, "isv"),
    ("Battery Meter",                                             "plugin",   0, "isv"),
]

AUTHORS = ["chriopter", "Homebrew Collective", "anon"]

# Summaries of every length: nothing at all, a few words, a line that fills
# the row, and one past the sixty characters the client keeps.
SUMMARIES = [
    "",
    "Small.",
    "Downhill racing with a penguin.",
    "Thirteen Graphics Engine tricks, one scene each.",
    "Real-time ray tracing on a 333 MHz MIPS CPU.",
    "A tidy little thing that does one job and gets out of the way again.",
    "Reads the stick.",
    "Plays music.",
    "An unusually long summary, written to run past the sixty characters the "
    "client keeps for one, so the end of it has to go somewhere.",
    "Fast.",
]

LICENSES = ["GPL-2.0", "MIT", "BSD-3-Clause", "Apache-2.0", "Zlib"]

# Revisions count from a fixed point, so the numbers look like the published
# catalog's without depending on the clock.
REV_BASE = 1789000000


def slug(name):
    out = "".join(c for c in name if c.isalnum())
    return out[:16] or "App"


def fetch(url, dest):
    if os.path.exists(dest):
        return dest
    os.makedirs(os.path.dirname(dest), exist_ok=True)
    urllib.request.urlretrieve(url, dest + ".part")
    os.replace(dest + ".part", dest)
    return dest


def assets(work):
    """The three published apps' icons, shots and films, and one real EBOOT,
    fetched once into the work directory and reused from there."""
    cache = os.path.join(work, "mock-assets")
    cat = json.load(urllib.request.urlopen(SRC + "catalog.json"))
    apps = cat["apps"]
    have = {"icon": [], "screenshot": [], "video": []}
    for a in apps:
        for kind in have:
            rel = a.get(kind)
            if rel:
                have[kind].append(fetch(SRC + rel, os.path.join(cache, rel)))

    # A real EBOOT.PBP, out of the smallest published release: it goes into
    # every planted PSP/GAME directory so START has something to launch, and
    # into every package so an install is a real install.
    eboot = os.path.join(cache, "EBOOT.PBP")
    if not os.path.exists(eboot):
        small = min((a for a in apps if a.get("release")),
                    key=lambda a: a["release"]["size"])
        raw = urllib.request.urlopen(small["release"]["url"]).read()
        z = zipfile.ZipFile(io.BytesIO(raw))
        name = sorted(n for n in z.namelist() if n.lower().endswith("eboot.pbp"))[0]
        os.makedirs(cache, exist_ok=True)
        open(eboot, "wb").write(z.read(name))
    return have, eboot


def package(site, entry_id, dirname, payload):
    """One package per entry, with the EBOOT one directory down under the
    name that directory will have on the stick, so thirty installs do not
    land on top of each other."""
    buf = io.BytesIO()
    with zipfile.ZipFile(buf, "w", zipfile.ZIP_DEFLATED) as w:
        w.writestr("README.md", "%s, from the mock catalog.\n" % dirname)
        w.writestr("%s/EBOOT.PBP" % dirname, payload)
    blob = buf.getvalue()
    rel = "pkgs/%s.zip" % entry_id
    out = os.path.join(site, rel)
    os.makedirs(os.path.dirname(out), exist_ok=True)
    open(out, "wb").write(blob)
    return rel, hashlib.sha256(blob).hexdigest(), len(blob)


def make(work, ms, base):
    rng = random.Random(SEED)
    # A run starts from the state this file describes and no other: an
    # install or an update done in the client during the last one left a
    # record of its own behind, and those thirds are the point.
    clean(work, ms, quiet=True)
    site = os.path.join(work, "mock-site")
    shutil.rmtree(site, ignore_errors=True)
    os.makedirs(site)
    have, eboot = assets(work)
    payload = open(eboot, "rb").read()

    # A third of the rows in each state, mixed rather than every third row.
    third = COUNT // 3
    states = (["current"] * third + ["update"] * third +
              ["none"] * (COUNT - 2 * third))
    rng.shuffle(states)

    db_dir = os.path.join(ms, "PSP/PSPDX/INSTALLED")
    game_dir = os.path.join(ms, "PSP/GAME")
    os.makedirs(db_dir, exist_ok=True)
    os.makedirs(game_dir, exist_ok=True)
    planted = []
    apps = []
    installed = {}

    for i, (name, category, author, kinds) in enumerate(ROWS[:COUNT]):
        entry_id = "%sapp%02d%s" % (ID_PREFIX, i, slug(name).lower()[:32])
        dirname = "%s%02d%s" % (DIR_PREFIX, i, slug(name)[:21])
        rev = REV_BASE + i * 1000
        version = "%d.%d.%d" % (1 + i // 10, i % 10, i % 3)
        rel, sha, size = package(site, entry_id, dirname, payload)

        app = {
            "id": entry_id,
            "repo": "https://github.com/pspdxmock/" + entry_id[len(ID_PREFIX):],
            "installdir": "PSP/GAME/" + dirname,
            "name": name,
            "author": AUTHORS[author],
            "summary": SUMMARIES[rng.randrange(len(SUMMARIES))],
            "category": category,
            "license": LICENSES[i % len(LICENSES)],
            "release": {
                "rev": rev,
                "url": base + rel,
                "sha256": sha,
                "size": size,
                "version": version,
            },
        }
        # The assets, laid out the way the published catalog lays them out:
        # one directory an app, the kind and a hash of the bytes in the name.
        # The client keys its cache on the served name, so a mock that names
        # its files differently would exercise a path the real one never
        # takes.
        for kind, letter, called, ext in (("icon", "i", "icon", "png"),
                                          ("screenshot", "s", "picture", "png"),
                                          ("video", "v", "film", "mp4")):
            if letter not in kinds:
                continue
            src = have[kind][i % len(have[kind])]
            eight = hashlib.sha256(open(src, "rb").read()).hexdigest()[:8]
            rel_asset = "apps/%s/%s-%s.%s" % (entry_id, called, eight, ext)
            dest = os.path.join(site, rel_asset)
            os.makedirs(os.path.dirname(dest), exist_ok=True)
            shutil.copyfile(src, dest)
            app[kind] = rel_asset
        manifest=dict(schema="https://github.com/chriopter/pspdx/blob/master/schema/v1.pspdx",source=app["repo"],name=name[:39],category=category,installdir=app["installdir"])
        app["_test_manifest"]=manifest
        apps.append(app)

        state = states[i]
        if state == "none":
            continue
        if state == "current":
            record = {"id": entry_id, "rev": rev, "dir": dirname,
                      "manifest": "", "version": version}
        else:
            # Behind the catalog by a revision and a version, which is the
            # one thing that puts the update arrows on a row.
            record = {"id": entry_id, "rev": rev - 500, "dir": dirname,
                      "manifest": "",
                      "version": "%d.%d.%d" % (i // 10, i % 10, i % 3)}
        rec_path = os.path.join(db_dir, entry_id + ".pspdx")
        with open(rec_path,"w") as output:json.dump(manifest,output)
        installed[entry_id]=dict(source=app["repo"],added_from=base,installed=dict(version=record["version"],published_at=record["rev"],installdir=app["installdir"]))
        planted.append("db " + rec_path)

        # An installed app is a directory with an EBOOT in it, or START has
        # nothing to launch.
        target = os.path.join(game_dir, dirname)
        os.makedirs(target, exist_ok=True)
        shutil.copyfile(eboot, os.path.join(target, "EBOOT.PBP"))
        planted.append("dir " + target)

    catalog = {
        "schema": "https://github.com/chriopter/pspdx/blob/master/schema/catalog-v1.json",
        "generated": "2026-01-01T00:00:00Z",
        "apps": apps,
    }
    json.dump(catalog, open(os.path.join(site, "catalog.json"), "w"))
    for app_id, record in installed.items():
        path = os.path.join(db_dir, app_id + ".state.json")
        with open(path, "w") as output:
            json.dump(record, output)
        planted.append("db " + path)
    open(os.path.join(work, "mock-planted"), "w").write("\n".join(planted) + "\n")

    waiting = states.count("update")
    print("mock catalog: %d apps, %d installed, %d updates waiting"
          % (len(apps), states.count("current") + waiting, waiting))


def clean(work, ms, quiet=False):
    """What make wrote down, and what an install done from the mock catalog
    in the client added next to it: a record whose id carries the mock
    prefix, a PSP/GAME directory named with it, a cached asset under one of
    those ids. Every path is checked for the prefix and for the directory it
    is supposed to sit in before anything is removed -- the user's real
    installs are in the same two directories and carry neither."""
    db_dir = os.path.realpath(os.path.join(ms, "PSP/PSPDX/INSTALLED"))
    game_dir = os.path.realpath(os.path.join(ms, "PSP/GAME"))
    cache_dir = os.path.realpath(os.path.join(ms, "PSP/PSPDX/CACHE/media"))

    # Remove only old mock entries if a pre-migration fixture remains.
    state_path=os.path.join(db_dir,"state.json")
    if os.path.exists(state_path):
        state=json.load(open(state_path))
        state={key:value for key,value in state.items() if not key.startswith(ID_PREFIX)}
        with open(state_path,"w") as output:json.dump(state,output)
    # The manifest names what make planted; the sweep of the three
    # directories catches what the client planted afterwards.
    listing = os.path.join(work, "mock-planted")
    found = []
    if os.path.exists(listing):
        for line in open(listing):
            kind, _, path = line.strip().partition(" ")
            if kind in ("db", "dir") and path:
                found.append(path)
        os.remove(listing)
    for directory in (db_dir, game_dir, cache_dir):
        for name in sorted(os.listdir(directory)) if os.path.isdir(directory) else []:
            found.append(os.path.join(directory, name))

    gone = 0
    for path in found:
        real = os.path.realpath(path)
        parent, base = os.path.split(real)
        if parent == game_dir:
            if not base.startswith(DIR_PREFIX):
                continue
        elif parent in (db_dir, cache_dir):
            if not base.startswith(ID_PREFIX):
                continue
        else:
            continue
        if os.path.isdir(real):
            shutil.rmtree(real)
        elif os.path.exists(real):
            os.remove(real)
        else:
            continue
        gone += 1
    if gone and not quiet:
        print("mock catalog: %d planted records, directories and assets removed"
              % gone)


def main():
    if len(sys.argv) < 2 or sys.argv[1] not in ("make", "clean"):
        sys.exit(__doc__)
    opts = dict(zip(sys.argv[2::2], sys.argv[3::2]))
    work, ms = opts.get("--work"), opts.get("--ms")
    if not work or not ms:
        sys.exit("mock-catalog: --work and --ms are required")
    os.makedirs(work, exist_ok=True)
    if sys.argv[1] == "clean":
        clean(work, ms)
    else:
        # Packages are named by an absolute URL; the assets beside them are
        # relative to the catalog, as in the published one. The caller owns
        # the address, so it says what it is.
        url = opts.get("--url", DEFAULT_URL)
        make(work, ms, url.rsplit("/", 1)[0] + "/")


if __name__ == "__main__":
    main()
