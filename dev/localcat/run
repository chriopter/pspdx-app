#!/bin/sh
# A catalog of forty apps on the host, over TLS, for exercising the list:
# builds the client against a throwaway CA and a loopback catalog URL, serves
# the published catalog's own assets under forty ids, runs the rig with the
# arguments given, and rebuilds the client for the real catalog afterwards.
#
#   sh dev/localcat/run [rig arguments]
#
# The work directory, the CA and the two builds are common.sh's; dev/start
# --mock uses the same ones for a mixed catalog on the desk.
set -e
HERE="$(cd "$(dirname "$0")" && pwd)"
APP="$(cd "$HERE/../../app" && pwd)"
. "$HERE/common.sh"
mkdir -p "$WORK/site"

# The published catalog and its assets, fetched once, then forty entries
# made of them.
if [ ! -f "$WORK/site/catalog.json" ]; then
	python3 "$HERE/make-catalog.py" "$WORK/site"
fi

# The client, pointed at the host. The objects that see the URL or the CA
# are rebuilt here and again at the end.
localcat_build_local

# A mock server from dev/start --mock would be holding the port.
localcat_stop_server
python3 "$HERE/serve.py" "$WORK/site" "$WORK/srv.crt" "$WORK/srv.key" "$LOCALCAT_PORT" &
SRV=$!
sleep 1
trap 'kill $SRV 2>/dev/null' EXIT

sh "$HERE/../rig" "$@" || true

# Back to the real catalog.
localcat_build_real
