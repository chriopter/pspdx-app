#!/usr/bin/env python3
"""Writes app/install/codepages.h: CP437 and Shift-JIS (CP932) to Unicode, for
zip entry names that do not say they are UTF-8. Run from the repository root."""
cp437 = [ord(bytes([b]).decode('cp437')) for b in range(128, 256)]
lead = list(range(0x81, 0xA0)) + list(range(0xE0, 0xFD))
out = ['/* Generated by dev/tools/gen-codepages; do not edit. */',
       '/* CP437 bytes 0x80-0xFF, as the zip format reads a name with no UTF-8 flag. */',
       'static const unsigned short CP437_HIGH[128] = {']
out += ['    ' + ', '.join(f'0x{c:04X}' for c in cp437[i:i + 8]) + ',' for i in range(0, 128, 8)]
out += ['};', '',
        '/* Shift-JIS as Windows writes it (CP932): single bytes 0xA1-0xDF are',
        '   half-width katakana; a lead byte 0x81-0x9F or 0xE0-0xFC and a trail byte',
        '   0x40-0xFC make one character, 0 where CP932 has none. Indexed by',
        '   SJIS_LEAD(lead) * 189 + trail - 0x40. */',
        '#define SJIS_LEAD(b) ((b) < 0xA0 ? (b) - 0x81 : (b) - 0xE0 + 31)',
        f'static const unsigned short SJIS_DOUBLE[{len(lead)} * 189] = {{']
for l in lead:
    row = []
    for t in range(0x40, 0xFD):
        try:
            s = bytes([l, t]).decode('cp932')
            row.append(ord(s) if len(s) == 1 else 0)
        except UnicodeDecodeError:
            row.append(0)
    out += ['    ' + ', '.join(f'0x{c:04X}' for c in row[i:i + 12]) + ',' for i in range(0, 189, 12)]
out += ['};', '']
open('app/install/codepages.h', 'w').write('\n'.join(out))
