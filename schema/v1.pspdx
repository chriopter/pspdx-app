{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chriopter/pspdx/blob/master/schema/v1.pspdx",
  "title": ".pspdx",
  "description": "What a PSP homebrew repository says about itself to PSPDX. The version, the date, the package and its size come from the latest release; the id from the repository; the folder on the stick from the zip; the icon, the picture, the film and the sound out of the EBOOT.",
  "type": "object",
  "required": [
    "schema",
    "name",
    "category"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "https://github.com/chriopter/pspdx/blob/master/schema/v1.pspdx"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 39,
      "description": "what the list shows"
    },
    "summary": {
      "type": "string",
      "maxLength": 60,
      "description": "one line; the repository's description otherwise"
    },
    "category": {
      "enum": [
        "game",
        "emulator",
        "app",
        "plugin",
        "demo"
      ],
      "description": "what this one app is; the list shows the plural"
    },
    "license": {
      "type": "string",
      "maxLength": 15,
      "description": "an SPDX identifier; what GitHub reports otherwise"
    },
    "author": {
      "type": "string",
      "maxLength": 39,
      "description": "a name; the repository's owner otherwise"
    }
  },
  "$defs": {}
}
