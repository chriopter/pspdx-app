{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chriopter/pspdx/blob/master/schema/v1.pspdx",
  "title": ".pspdx",
  "description": "What a PSP homebrew repository says about itself to PSPDX. The version, the date, the package and its size come from the latest release; the id from the repository; the icon, the picture, the film and the sound out of the EBOOT.",
  "type": "object",
  "required": [
    "schema",
    "source",
    "name",
    "category",
    "installdir"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "https://github.com/chriopter/pspdx/blob/master/schema/v1.pspdx"
    },
    "source": {
      "type": "string",
      "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/?(?![\\s\\S])",
      "description": "The project source URL. Version 1 supports HTTPS GitHub repository URLs."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 39,
      "description": "what the list shows"
    },
    "summary": {
      "type": "string",
      "maxLength": 60,
      "description": "one line; the repository's description otherwise"
    },
    "category": {
      "enum": [
        "game",
        "emulator",
        "app",
        "plugin",
        "demo"
      ],
      "description": "what this one app is; the list shows the plural"
    },
    "license": {
      "type": "string",
      "maxLength": 64,
      "description": "an SPDX identifier; what GitHub reports otherwise"
    },
    "author": {
      "type": "string",
      "maxLength": 39,
      "description": "a name; the repository's owner otherwise"
    },
    "installdir": {
      "type": "string",
      "pattern": "^PSP/GAME/(?![.]{1,2}$)[A-Za-z0-9_.-]{1,32}(?![\\s\\S])",
      "description": "where the package goes on the Memory Stick: the directory in the zip that holds the EBOOT.PBP, with everything beside and below it, is copied here. In version 1 it is PSP/GAME/<folder>, and the folder is the name the XMB shows; a later version may allow other places on the stick."
    }
  },
  "$defs": {}
}
