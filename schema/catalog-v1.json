{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chriopter.github.io/pspdx/schema/catalog-v1.json",
  "title": "PSPDX catalog v1",
  "description": "Aggregated homebrew metadata, release packages and optional EBOOT media. Individual source manifests use schema/pspdx-v1.json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "generated_at",
    "apps"
  ],
  "properties": {
    "schema": {
      "const": "https://chriopter.github.io/pspdx/schema/catalog-v1.json"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "description": "Time this catalog snapshot was published. Some apps may have been omitted if their source failed."
    },
    "apps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/app"
      }
    }
  },
  "$defs": {
    "app": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "author",
        "summary",
        "category",
        "license",
        "source",
        "installdir",
        "release"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 39,
          "description": "what the list shows"
        },
        "author": {
          "type": "string",
          "maxLength": 39,
          "description": "a name; the repository's owner otherwise"
        },
        "summary": {
          "type": "string",
          "maxLength": 60,
          "description": "one line; the repository's description otherwise"
        },
        "category": {
          "enum": [
            "game",
            "emulator",
            "app",
            "plugin",
            "demo"
          ],
          "description": "what this one app is; the list shows the plural"
        },
        "license": {
          "type": "string",
          "maxLength": 64,
          "description": "an SPDX identifier; what GitHub reports otherwise"
        },
        "installdir": {
          "type": "string",
          "pattern": "^PSP/GAME/(?![.]{1,2}$)[A-Za-z0-9_.-]{1,32}(?![\\s\\S])",
          "description": "where the package goes on the Memory Stick: the directory in the zip that holds the EBOOT.PBP, with everything beside and below it, is copied here. In version 1 it is PSP/GAME/<folder>, and the folder is the name the XMB shows; a later version may allow other places on the stick."
        },
        "id": {
          "type": "string",
          "pattern": "^io\\.github\\.[a-z0-9]+\\.[a-z0-9]+(?![\\s\\S])",
          "description": "Repository identity: lowercase owner and repository with non-alphanumeric characters removed."
        },
        "source": {
          "type": "string",
          "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/?(?![\\s\\S])",
          "description": "The project source URL. Version 1 supports HTTPS GitHub repository URLs."
        },
        "release": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tag",
            "published_at",
            "download"
          ],
          "properties": {
            "tag": {
              "type": "string",
              "minLength": 1,
              "maxLength": 31,
              "description": "The original GitHub release tag."
            },
            "published_at": {
              "type": "string",
              "format": "date-time",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
              "description": "GitHub release publication time in UTC. Clients compare this to the installed release to find updates."
            },
            "download": {
              "type": "object",
              "additionalProperties": false,
              "required": ["url", "size", "sha256"],
              "properties": {
                "url": {"type": "string", "format": "uri", "pattern": "^https://", "description": "Author's GitHub release ZIP URL."},
                "size": {"type": "integer", "minimum": 1, "description": "ZIP size in bytes."},
                "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}(?![\\s\\S])", "description": "SHA-256 of the ZIP bytes."}
              }
            }
          }
        },
        "media": {
          "type": "object",
          "additionalProperties": false,
          "description": "Optional EBOOT media URLs, absolute or relative to the catalog URL.",
          "properties": {
            "icon": {"type": "string", "minLength": 1, "format": "uri-reference"},
            "screenshot": {"type": "string", "minLength": 1, "format": "uri-reference"},
            "video": {"type": "string", "minLength": 1, "format": "uri-reference"},
            "sound": {"type": "string", "minLength": 1, "format": "uri-reference"}
          }
        }
      }
    }
  }
}
